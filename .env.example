# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Domain, unter der das Portal erreichbar ist (DNS muss auf den Server zeigen)
DOMAIN=portal.monsipan.at

# Erster Admin-Zugang – wird nur beim allerersten Start angelegt.
# Ohne Passwort wird eines erzeugt und einmalig im Log angezeigt (docker compose logs app).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# E-Mail-Versand (Passwort vergessen, Einladungen, Warnungen zum Mindestbestand)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Monsipan Portal <lager@monsipan.at>"

# Digitale Rechnungssignatur (siehe README „Rechnungen: Ausstellen, Signatur und Archiv“)
# Passwort für den Schlüssel des eigenen Zertifikats – mindestens 12 Zeichen, gut aufbewahren
SIGNATUR_PASSWORT=
# Nur für einen Vertrauensdiensteanbieter über die CSC-API (z. B. A-Trust)
SIGNATUR_CSC_SECRET=
SIGNATUR_CSC_PIN=
# Nur für einen Zeitstempeldienst mit Anmeldung (z. B. qualifizierte Zeitstempel)
SIGNATUR_TSA_BENUTZER=
SIGNATUR_TSA_PASSWORT=

# Beispielartikel und -buchungen beim ersten Start anlegen (nur zum Ausprobieren!)
DEMO_DATA=false
